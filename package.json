{
  "name": "single-timeline-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build:worker-assets",
    "build:worker-assets": "node worker/build-inline-assets.mjs",
    "build": "node build.mjs",
    "test": "npm run build:worker-assets && node --test test/*.test.js worker/test/*.test.js",
    "test:browser": "playwright test",
    "check:worker": "wrangler deploy --dry-run --config worker/wrangler.toml",
    "check:pages": "wrangler pages functions build --outfile /tmp/yuki-pages-functions.js"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "markdown-it": "15.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "wrangler": "4.147.0"
  }
}
